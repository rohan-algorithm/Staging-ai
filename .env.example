PORT=8080

# Permanent user accounts, jobs, and purchases.
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/virtualstage
MONGODB_URI=
MONGODB_DB=virtualstage

# Uploaded listing photos and staged results.
# Dashboard → https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional live furniture render. Without this, sample rooms are saved.
REPLICATE_API_TOKEN=

# Optional card checkout. Without this, credits are added in demo mode.
STRIPE_SECRET_KEY=
