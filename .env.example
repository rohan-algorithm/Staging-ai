PORT=8080

# The demo account is created only when NODE_ENV is not production.

# Permanent user accounts, jobs, and purchases.
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/virtualstage
MONGODB_URI=
MONGODB_DB=virtualstage

# Uploaded listing photos and staged results.
# Dashboard → https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Edits the uploaded photo (FLUX Kontext). Without this, staging returns an error.
REPLICATE_API_TOKEN=

# Card checkout through Dodo Payments. Without this, local checkout adds credits in demo mode.
# Production uses a live key and live_mode. Test keys use test_mode.
# Webhook endpoint: https://roomgenix.com/api/webhooks/dodo
# Dashboard → https://app.dodopayments.com
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode

# Optional. Leave blank to create the credit-pack products from the API key.
DODO_PRODUCT_SINGLE=
DODO_PRODUCT_LISTING=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_AGENCY=

# Optional. Used only when Dodo is not configured.
STRIPE_SECRET_KEY=

# Google Analytics 4. Admin → Data Streams → Measurement ID, looks like G-XXXXXXXX.
# Leave blank to keep the tag off.
GA_MEASUREMENT_ID=

# Sign in with Google. Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized JavaScript origins: http://localhost:8080 and the live site origin.
GOOGLE_CLIENT_ID=
